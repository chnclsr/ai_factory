{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "AI Factory routing flow",
    "quality_profile": "showcase",
    "locale": "en",
    "animation": "none",
    "views": [
      { "id": "secim", "label": "Engine selection", "focus": ["task", "select", "allowlist"], "note": "Tasks use an explicitly selected engine or the routing rules." },
      { "id": "calistirma", "label": "Execution and result", "focus": ["gate", "execute", "report"], "note": "Health checks and CLI output determine the reported outcome." },
      { "id": "devretme", "label": "Failure and handoff", "focus": ["execute", "fallback", "report"], "note": "Fallback order depends on the engine; Gemini handoffs appear in the report." }
    ]
  },
  "lanes": [
    { "id": "main", "label": "Select, execute, report" },
    { "id": "branch", "label": "Session and fallback", "variant": "exception" }
  ],
  "mainPath": ["task", "select", "allowlist", "gate", "execute", "report"],
  "nodes": [
    { "id": "task", "lane": "main", "col": 0, "type": "frontend", "label": "Task", "sublabel": "--task / --resume" },
    { "id": "select", "lane": "main", "col": 1, "type": "backend", "label": "Select engine", "sublabel": "Request / rules" },
    { "id": "allowlist", "lane": "main", "col": 2, "type": "security", "label": "Validate model", "sublabel": "Allowlist" },
    { "id": "gate", "lane": "main", "col": 3, "type": "security", "label": "Health check", "sublabel": "Quota / quarantine" },
    { "id": "execute", "lane": "main", "col": 4, "type": "backend", "label": "Run CLI", "sublabel": "Response + session ID" },
    { "id": "report", "lane": "main", "col": 5, "type": "frontend", "label": "Execution report", "sublabel": "path + succeed_with", "width": 164 },
    { "id": "fallback", "lane": "branch", "col": 3, "type": "messagebus", "label": "Fallback / Gemini", "sublabel": "Engine-specific order", "width": 164 }
  ],
  "edges": [
    { "from": "task", "to": "select", "variant": "emphasis" },
    { "from": "select", "to": "allowlist", "variant": "security" },
    { "from": "allowlist", "to": "gate", "variant": "security" },
    { "from": "gate", "to": "execute", "label": "allowed", "variant": "emphasis" },
    { "from": "execute", "to": "report", "label": "response", "variant": "emphasis" },
    { "from": "gate", "to": "fallback", "label": "quarantined", "variant": "security", "role": "error" },
    { "from": "execute", "to": "fallback", "label": "eligible error", "variant": "security", "role": "error" },
    { "from": "fallback", "to": "report", "label": "final status", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Starting point", "items": ["Default route: Puter Flash", "--resume uses the saved session"] },
    { "dot": "rose", "title": "Guardrails", "items": ["OpenCode: free models; Claude: allowlisted", "--no-fallback stops after the selected engine"] },
    { "dot": "emerald", "title": "Report", "items": ["path shows only engines from the current call", "A Gemini handoff returns work to the parent agent"] }
  ]
}
