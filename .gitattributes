# Text files are stored with LF in the repository; Git converts them for the platform on checkout.
* text=auto

# Windows scripts must keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Generated diagram viewers: keep them out of language statistics and diffs.
docs/diagrams/*.html linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
