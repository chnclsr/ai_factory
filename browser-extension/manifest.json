{
  "manifest_version": 3,
  "name": "AI Factory model picker",
  "version": "1.1.0",
  "description": "Actor and critic pickers above Antigravity's prompt box; the choice is added to the prompt on send.",
  "content_scripts": [
    {
      "matches": [
        "https://antigravity.google.com/*",
        "https://antigravity.static.usercontent.goog/*"
      ],
      "js": [
        "models.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
